{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/provider-membership.v0.3.json",
  "title": "Provider membership",
  "type": "object",
  "additionalProperties": false,
  "required": ["user", "role", "createdAt", "updatedAt"],
  "properties": {
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "email", "displayName"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "email": {
          "anyOf": [
            { "type": "string", "format": "email", "maxLength": 320 },
            { "type": "null" }
          ]
        },
        "displayName": {
          "anyOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }]
        }
      }
    },
    "role": { "enum": ["owner", "admin", "developer", "viewer"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
