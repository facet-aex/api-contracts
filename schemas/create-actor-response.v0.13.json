{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/create-actor-response.v0.13.json",
  "title": "CreateActorResponseV013",
  "type": "object",
  "additionalProperties": false,
  "required": ["facet"],
  "properties": {
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "versionId",
        "slug",
        "facetType",
        "imageDigest",
        "status",
        "visibility",
        "publishedAt"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "versionId": { "type": "string", "format": "uuid" },
        "slug": { "type": "string" },
        "facetType": { "const": "HOSTED_ACTOR" },
        "imageDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "status": { "const": "PUBLISHED" },
        "visibility": { "const": "PUBLIC" },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
