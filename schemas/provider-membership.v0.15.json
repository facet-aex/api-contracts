{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/provider-membership.v0.15.json",
  "title": "ProviderMembershipV015",
  "type": "object",
  "additionalProperties": false,
  "required": ["user", "role", "createdAt", "updatedAt"],
  "properties": {
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clerkId", "username", "email", "displayName"],
      "properties": {
        "clerkId": { "type": "string", "minLength": 1 },
        "username": {
          "type": "string",
          "minLength": 8,
          "maxLength": 16,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "email": {
          "anyOf": [
            { "type": "string", "format": "email", "maxLength": 320 },
            { "type": "null" }
          ]
        },
        "displayName": {
          "anyOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }]
        }
      }
    },
    "role": { "enum": ["owner", "admin", "developer", "viewer"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
