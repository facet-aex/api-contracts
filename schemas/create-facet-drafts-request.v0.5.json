{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/create-facet-drafts-request.v0.5.json",
  "title": "Create Facet drafts from operation selections",
  "type": "object",
  "additionalProperties": false,
  "required": ["providerId", "importJobId", "selections"],
  "properties": {
    "providerId": { "type": "string", "format": "uuid" },
    "importJobId": { "type": "string", "format": "uuid" },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationCandidateId",
          "slug",
          "name",
          "category",
          "tags",
          "sideEffectClass"
        ],
        "properties": {
          "operationCandidateId": { "type": "string", "format": "uuid" },
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "summary": { "type": "string", "maxLength": 280 },
          "description": { "type": "string", "maxLength": 10000 },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "tags": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 40 }
          },
          "sideEffectClass": {
            "enum": [
              "READ_ONLY",
              "IDEMPOTENT_WRITE",
              "NON_IDEMPOTENT_WRITE",
              "UNKNOWN"
            ]
          }
        }
      }
    }
  }
}
