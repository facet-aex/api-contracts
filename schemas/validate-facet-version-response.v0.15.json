{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/validate-facet-version-response.v0.15.json",
  "title": "ValidateFacetVersionResponseV015",
  "type": "object",
  "additionalProperties": false,
  "required": ["facetVersion"],
  "properties": {
    "facetVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "revision",
        "validation",
        "warningAcknowledgements"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "status": { "enum": ["DRAFT", "VALID"] },
        "revision": { "type": "integer", "minimum": 1 },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "errors", "warnings"],
          "properties": {
            "status": { "enum": ["INVALID", "VALID"] },
            "errors": { "type": "array" },
            "warnings": { "type": "array" }
          }
        },
        "warningAcknowledgements": { "type": "array" }
      }
    }
  }
}
