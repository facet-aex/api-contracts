{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/secret-ref-response.v0.7.json",
  "title": "SecretRefResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["secret"],
  "properties": {
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "providerId",
        "kind",
        "label",
        "status",
        "usageCount",
        "createdAt",
        "rotatedAt"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "providerId": { "type": "string", "format": "uuid" },
        "kind": { "enum": ["API_KEY", "BEARER_TOKEN"] },
        "label": { "type": "string" },
        "status": { "enum": ["ACTIVE", "REVOKED"] },
        "usageCount": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" },
        "rotatedAt": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
