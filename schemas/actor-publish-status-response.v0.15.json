{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/actor-publish-status-response.v0.15.json",
  "title": "ActorPublishStatusResponseV015",
  "type": "object",
  "additionalProperties": false,
  "required": ["creator", "facetName", "version", "status"],
  "properties": {
    "creator": {
      "type": "string",
      "minLength": 8,
      "maxLength": 16,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "facetName": {
      "type": "string",
      "minLength": 4,
      "maxLength": 32,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": ["REGISTRATION_PENDING", "PUBLISHED", "REGISTRATION_FAILED"]
    },
    "registryTxHash": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "errorCode": { "type": "string", "minLength": 1, "maxLength": 120 }
  }
}
