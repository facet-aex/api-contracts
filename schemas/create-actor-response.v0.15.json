{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/create-actor-response.v0.15.json",
  "title": "CreateActorResponseV015",
  "type": "object",
  "additionalProperties": false,
  "required": ["facet"],
  "properties": {
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creator",
        "facetName",
        "facetDisplayName",
        "version",
        "facetType",
        "imageDigest",
        "status",
        "visibility",
        "publishedAt"
      ],
      "properties": {
        "creator": {
          "type": "string",
          "minLength": 8,
          "maxLength": 16,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "facetName": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "facetDisplayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "facetType": { "const": "ACTOR" },
        "imageDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "status": { "const": "PUBLISHED" },
        "visibility": { "const": "PUBLIC" },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
