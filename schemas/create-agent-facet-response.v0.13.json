{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/create-agent-facet-response.v0.13.json",
  "title": "CreateAgentFacetResponseV013",
  "type": "object",
  "additionalProperties": false,
  "required": ["facet"],
  "properties": {
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "versionId",
        "slug",
        "facetType",
        "erc8004TokenId",
        "erc8004Registry",
        "status",
        "visibility",
        "publishedAt"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "versionId": { "type": "string", "format": "uuid" },
        "slug": { "type": "string" },
        "facetType": { "const": "AUTONOMOUS_AGENT" },
        "erc8004TokenId": { "type": "string", "pattern": "^[0-9]+$" },
        "erc8004Registry": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        },
        "status": { "const": "PUBLISHED" },
        "visibility": { "const": "PUBLIC" },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
