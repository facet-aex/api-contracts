{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/actor-publish-status-response.v0.14.json",
  "title": "ActorPublishStatusResponseV014",
  "type": "object",
  "additionalProperties": false,
  "required": ["facetId", "versionId", "status"],
  "properties": {
    "facetId": { "type": "string", "format": "uuid" },
    "versionId": { "type": "string", "format": "uuid" },
    "fullName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "displayVersion": {
      "type": "string",
      "pattern": "^v?[0-9]+(?:\\.[0-9]+\\.[0-9]+)?$"
    },
    "status": {
      "enum": ["REGISTRATION_PENDING", "PUBLISHED", "REGISTRATION_FAILED"]
    },
    "registryTxHash": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "errorCode": { "type": "string", "minLength": 1, "maxLength": 120 }
  }
}
