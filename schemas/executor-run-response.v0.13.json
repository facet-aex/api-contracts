{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/executor-run-response.v0.13.json",
  "title": "ExecutorRunResponseV013",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "result", "dataset", "logs", "usage"],
  "properties": {
    "status": { "enum": ["SUCCEEDED", "FAILED"] },
    "result": {},
    "dataset": {
      "type": "array",
      "items": { "type": "object" }
    },
    "logs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemCount", "durationMs", "outputHash", "runnerSignature"],
      "properties": {
        "itemCount": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "outputHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runnerSignature": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]+$"
        }
      }
    }
  }
}
