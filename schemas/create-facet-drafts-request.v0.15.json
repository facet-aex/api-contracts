{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/create-facet-drafts-request.v0.15.json",
  "title": "CreateFacetDraftsRequestV015",
  "type": "object",
  "additionalProperties": false,
  "required": ["importJobId", "selections"],
  "properties": {
    "importJobId": { "type": "string", "format": "uuid" },
    "selections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationCandidateId",
          "facetName",
          "facetDisplayName",
          "category",
          "tags",
          "sideEffectClass"
        ],
        "properties": {
          "operationCandidateId": { "type": "string", "format": "uuid" },
          "facetName": {
            "type": "string",
            "minLength": 4,
            "maxLength": 32,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "facetDisplayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
          },
          "summary": { "type": "string", "maxLength": 280 },
          "description": { "type": "string", "maxLength": 10000 },
          "category": { "type": "string", "minLength": 1, "maxLength": 80 },
          "tags": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "minLength": 1, "maxLength": 40 }
          },
          "sideEffectClass": {
            "enum": [
              "READ_ONLY",
              "IDEMPOTENT_WRITE",
              "NON_IDEMPOTENT_WRITE",
              "UNKNOWN"
            ]
          }
        }
      }
    }
  }
}
