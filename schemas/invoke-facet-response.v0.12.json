{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/invoke-facet-response.v0.12.json",
  "title": "InvokeFacetResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "facetVersionId", "result", "replayed"],
  "properties": {
    "runId": { "type": "string", "format": "uuid" },
    "facetVersionId": { "type": "string", "format": "uuid" },
    "result": {},
    "replayed": { "type": "boolean" },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transaction", "network"],
      "properties": {
        "transaction": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" },
        "network": { "const": "eip155:43113" }
      }
    }
  }
}
