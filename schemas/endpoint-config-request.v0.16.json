{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/endpoint-config-request.v0.16.json",
  "title": "EndpointConfigRequestV016",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "baseUrl",
    "auth",
    "timeoutMs",
    "maxResponseBytes",
    "redirectPolicy"
  ],
  "properties": {
    "revision": { "type": "integer", "minimum": 1 },
    "baseUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "NONE" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "secretRefId"],
          "properties": {
            "kind": { "enum": ["BEARER", "BASIC"] },
            "secretRefId": { "type": "string", "format": "uuid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "secretRefId", "parameterName"],
          "properties": {
            "kind": { "enum": ["API_KEY_HEADER", "API_KEY_QUERY"] },
            "secretRefId": { "type": "string", "format": "uuid" },
            "parameterName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9._~-]+$"
            }
          }
        }
      ]
    },
    "staticHeaders": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 2048 }
    },
    "requestBodyMediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "datasetPath": { "type": "string", "minLength": 1, "maxLength": 160 },
    "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
    "maxResponseBytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 10485760
    },
    "redirectPolicy": { "enum": ["DENY", "SAME_ORIGIN"] }
  }
}
