{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/create-agent-facet-request.v0.15.json",
  "title": "CreateAgentFacetRequestV015",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "facetName",
    "facetDisplayName",
    "description",
    "category",
    "erc8004TokenId",
    "taskKind",
    "inputSchema"
  ],
  "properties": {
    "facetName": {
      "type": "string",
      "minLength": 4,
      "maxLength": 32,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "facetDisplayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "summary": { "type": "string", "maxLength": 280 },
    "description": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "category": { "type": "string", "minLength": 1, "maxLength": 80 },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "erc8004TokenId": { "type": "string", "pattern": "^[0-9]+$" },
    "erc8004Registry": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
    "taskKind": { "type": "string", "minLength": 1, "maxLength": 80 },
    "code": { "type": "string", "maxLength": 131072 },
    "inputSchema": { "type": "object" },
    "outputSchema": { "type": "object" },
    "pricingModel": { "enum": ["PAY_PER_RUN", "PAY_PER_RESULT"] },
    "priceAtomic": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "payTo": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
    "registryTxHash": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" }
  }
}
