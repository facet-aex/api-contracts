{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/public-facet.v0.10.json",
  "title": "PublicFacet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "versionId",
    "slug",
    "name",
    "description",
    "category",
    "tags",
    "provider",
    "displayVersion",
    "method",
    "inputSchema",
    "outputSchema",
    "publishedAt"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "versionId": { "type": "string", "format": "uuid" },
    "slug": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slug"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "slug": { "type": "string" }
      }
    },
    "displayVersion": { "type": "string" },
    "method": { "type": "string" },
    "inputSchema": {},
    "outputSchema": {},
    "publishedAt": { "type": "string", "format": "date-time" }
  }
}
