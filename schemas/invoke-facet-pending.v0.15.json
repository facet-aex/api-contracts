{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/invoke-facet-pending.v0.15.json",
  "title": "InvokeFacetPendingResponseV015",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "creator", "facetName", "version", "payment"],
  "properties": {
    "runId": { "type": "string", "format": "uuid" },
    "creator": {
      "type": "string",
      "minLength": 8,
      "maxLength": 16,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "facetName": {
      "type": "string",
      "minLength": 4,
      "maxLength": 32,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": [
            "settlement_pending",
            "receipt_pending",
            "escrow_pending",
            "refund_pending"
          ]
        },
        "transaction": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" }
      }
    }
  }
}
