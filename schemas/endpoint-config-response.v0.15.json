{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/endpoint-config-response.v0.15.json",
  "title": "EndpointConfigResponseV015",
  "type": "object",
  "additionalProperties": false,
  "required": ["endpointConfig"],
  "properties": {
    "endpointConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "facetName",
        "version",
        "facetVersionRevision",
        "baseUrlConfigured",
        "method",
        "pathTemplate",
        "authKind",
        "secretConfigured",
        "timeoutMs",
        "maxResponseBytes",
        "redirectPolicy",
        "revision",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 8,
          "maxLength": 16,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "facetName": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "facetVersionRevision": { "type": "integer", "minimum": 1 },
        "baseUrlConfigured": { "const": true },
        "method": { "type": "string" },
        "pathTemplate": { "type": "string" },
        "authKind": {
          "enum": ["NONE", "API_KEY_HEADER", "API_KEY_QUERY", "BEARER"]
        },
        "secretConfigured": { "type": "boolean" },
        "timeoutMs": { "type": "integer" },
        "maxResponseBytes": { "type": "integer" },
        "redirectPolicy": { "enum": ["DENY", "SAME_ORIGIN"] },
        "revision": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
