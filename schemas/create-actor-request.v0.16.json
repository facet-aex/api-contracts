{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/create-actor-request.v0.16.json",
  "title": "CreateActorRequestV016",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "facetName",
    "facetDisplayName",
    "description",
    "category",
    "inputSchema",
    "code"
  ],
  "properties": {
    "facetName": {
      "type": "string",
      "minLength": 4,
      "maxLength": 32,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "facetDisplayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "summary": { "type": "string", "maxLength": 280 },
    "description": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "category": { "type": "string", "minLength": 1, "maxLength": 80 },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "inputSchema": { "type": "object" },
    "outputSchema": { "type": "object" },
    "code": { "type": "string", "minLength": 10, "maxLength": 131072 },
    "pricingModel": { "enum": ["PAY_PER_RUN", "PAY_PER_RESULT"] },
    "priceAtomic": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "maxItemsCap": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "pricingOptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "priceAtomic"],
        "properties": {
          "model": { "enum": ["PAY_PER_RUN", "PAY_PER_RESULT"] },
          "priceAtomic": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "maxItemsCap": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "isPrimary": { "type": "boolean" }
        }
      }
    },
    "payTo": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
    "registryTxHash": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" }
  }
}
