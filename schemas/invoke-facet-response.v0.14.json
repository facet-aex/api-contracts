{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/invoke-facet-response.v0.14.json",
  "title": "InvokeFacetResponseV014",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "facetVersionId",
    "result",
    "replayed",
    "payment",
    "receipt"
  ],
  "properties": {
    "runId": { "type": "string", "format": "uuid" },
    "facetVersionId": { "type": "string", "format": "uuid" },
    "facetType": {
      "enum": ["EXTERNAL_HTTP_API", "HOSTED_ACTOR", "AUTONOMOUS_AGENT"]
    },
    "result": {},
    "dataset": {
      "type": "array",
      "items": { "type": "object" }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemCount", "durationMs", "outputHash", "runnerSignature"],
      "properties": {
        "itemCount": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "outputHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runnerSignature": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]+$"
        }
      }
    },
    "replayed": { "type": "boolean" },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction",
        "network",
        "amountAtomic",
        "payer",
        "creatorPayTo"
      ],
      "properties": {
        "transaction": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" },
        "network": { "const": "eip155:43113" },
        "amountAtomic": { "type": "string", "pattern": "^[0-9]+$" },
        "payer": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "creatorPayTo": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "payTo": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputHash",
        "outputHash",
        "itemCount",
        "paymentTxHash",
        "receiptTxHash",
        "runnerSignature"
      ],
      "properties": {
        "inputHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "outputHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "itemCount": { "type": "integer", "minimum": 0 },
        "paymentTxHash": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{64}$"
        },
        "receiptTxHash": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{64}$"
        },
        "runnerSignature": { "type": "string", "pattern": "^0x[a-fA-F0-9]+$" }
      }
    }
  }
}
