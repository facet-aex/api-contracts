{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/create-facet-drafts-response.v0.5.json",
  "title": "Created Facet drafts",
  "type": "object",
  "additionalProperties": false,
  "required": ["facets"],
  "properties": {
    "facets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/facetDraft" }
    }
  },
  "$defs": {
    "facetDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "providerId",
        "slug",
        "type",
        "status",
        "visibility",
        "version",
        "createdAt",
        "draftVersion"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "providerId": { "type": "string", "format": "uuid" },
        "slug": { "type": "string", "minLength": 1 },
        "type": { "const": "EXTERNAL_HTTP_API" },
        "status": { "const": "DRAFT" },
        "visibility": { "const": "PRIVATE" },
        "version": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "draftVersion": { "$ref": "#/$defs/facetDraftVersion" }
      }
    },
    "facetDraftVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayVersion",
        "status",
        "sourceVersionId",
        "sourceOperationPointer",
        "contentHash",
        "version",
        "validation"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "displayVersion": { "type": "string", "minLength": 1 },
        "status": { "const": "DRAFT" },
        "sourceVersionId": { "type": "string", "format": "uuid" },
        "sourceOperationPointer": { "type": "string", "pattern": "^#/paths/" },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "version": { "type": "integer", "minimum": 1 },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "errors", "warnings"],
          "properties": {
            "status": { "const": "PENDING" },
            "errors": { "type": "array" },
            "warnings": { "type": "array" }
          }
        }
      }
    }
  }
}
