{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/create-api-facet-request.v0.16.json",
  "title": "CreateApiFacetRequestV016",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "facetName",
    "facetDisplayName",
    "description",
    "category",
    "method",
    "baseUrl",
    "pathTemplate",
    "auth",
    "inputSchema",
    "pricingOptions"
  ],
  "properties": {
    "facetName": {
      "type": "string",
      "minLength": 4,
      "maxLength": 32,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "facetDisplayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "summary": { "type": "string", "maxLength": 280 },
    "description": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "category": { "type": "string", "minLength": 1, "maxLength": 80 },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
    "baseUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
    "pathTemplate": { "type": "string", "pattern": "^/" },
    "sideEffectClass": {
      "enum": ["READ_ONLY", "IDEMPOTENT_WRITE", "NON_IDEMPOTENT_WRITE"]
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "NONE" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["BEARER", "BASIC"] },
            "secretRefId": { "type": "string", "format": "uuid" },
            "secretValue": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "secretLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "parameterName"],
          "properties": {
            "kind": { "enum": ["API_KEY_HEADER", "API_KEY_QUERY"] },
            "parameterName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9._~-]+$"
            },
            "secretRefId": { "type": "string", "format": "uuid" },
            "secretValue": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "secretLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        }
      ]
    },
    "staticHeaders": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 2048 }
    },
    "requestBodyMediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "datasetPath": { "type": "string", "minLength": 1, "maxLength": 160 },
    "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
    "maxResponseBytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 10485760
    },
    "redirectPolicy": { "enum": ["DENY", "SAME_ORIGIN"] },
    "inputSchema": { "type": "object" },
    "outputSchema": { "type": "object" },
    "pricingOptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "priceAtomic"],
        "properties": {
          "model": { "enum": ["PAY_PER_RUN", "PAY_PER_RESULT"] },
          "priceAtomic": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "maxItemsCap": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "isPrimary": { "type": "boolean" }
        }
      }
    },
    "payTo": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
    "visibility": { "enum": ["PUBLIC", "UNLISTED"] }
  }
}
