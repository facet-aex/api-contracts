{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/create-facet-drafts-response.v0.15.json",
  "title": "CreateFacetDraftsResponseV015",
  "type": "object",
  "additionalProperties": false,
  "required": ["facets"],
  "properties": {
    "facets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/facetDraft" }
    }
  },
  "$defs": {
    "facetDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creator",
        "facetName",
        "facetDisplayName",
        "type",
        "status",
        "visibility",
        "revision",
        "createdAt",
        "draftVersion"
      ],
      "properties": {
        "creator": {
          "type": "string",
          "minLength": 8,
          "maxLength": 16,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "facetName": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "facetDisplayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": { "const": "API" },
        "status": { "const": "DRAFT" },
        "visibility": { "const": "PRIVATE" },
        "revision": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "draftVersion": { "$ref": "#/$defs/facetDraftVersion" }
      }
    },
    "facetDraftVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "sourceVersionId",
        "sourceOperationPointer",
        "contentHash",
        "revision",
        "validation"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "status": { "const": "DRAFT" },
        "sourceVersionId": { "type": "string", "format": "uuid" },
        "sourceOperationPointer": { "type": "string", "pattern": "^#/paths/" },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "revision": { "type": "integer", "minimum": 1 },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "errors", "warnings"],
          "properties": {
            "status": { "const": "PENDING" },
            "errors": { "type": "array" },
            "warnings": { "type": "array" }
          }
        }
      }
    }
  }
}
