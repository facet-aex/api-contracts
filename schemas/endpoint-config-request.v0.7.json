{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/endpoint-config-request.v0.7.json",
  "title": "EndpointConfigRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "baseUrl",
    "auth",
    "timeoutMs",
    "maxResponseBytes",
    "redirectPolicy"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "baseUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["NONE", "API_KEY_HEADER", "API_KEY_QUERY", "BEARER"]
        },
        "secretRefId": { "type": "string", "format": "uuid" },
        "parameterName": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
    "maxResponseBytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 10485760
    },
    "redirectPolicy": { "enum": ["DENY", "SAME_ORIGIN"] }
  }
}
