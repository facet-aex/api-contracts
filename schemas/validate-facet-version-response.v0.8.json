{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/validate-facet-version-response.v0.8.json",
  "title": "ValidateFacetVersionResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["facetVersion"],
  "properties": {
    "facetVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "version",
        "validation",
        "warningAcknowledgements"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "status": { "enum": ["DRAFT", "VALID"] },
        "version": { "type": "integer", "minimum": 1 },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "errors", "warnings"],
          "properties": {
            "status": { "enum": ["INVALID", "VALID"] },
            "errors": {
              "type": "array",
              "items": { "$ref": "#/$defs/issue" }
            },
            "warnings": {
              "type": "array",
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/issue" },
                  {
                    "type": "object",
                    "required": ["warningId", "acknowledged"],
                    "properties": {
                      "warningId": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      },
                      "acknowledged": { "type": "boolean" }
                    }
                  }
                ]
              }
            }
          }
        },
        "warningAcknowledgements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["warningId", "acknowledgedAt", "acknowledgedBy"],
            "properties": {
              "warningId": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "reason": { "type": "string" },
              "acknowledgedAt": { "type": "string", "format": "date-time" },
              "acknowledgedBy": { "type": "string", "format": "uuid" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "path": { "type": "string" }
      }
    }
  }
}
