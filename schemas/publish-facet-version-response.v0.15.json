{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://facet.local/schemas/publish-facet-version-response.v0.15.json",
  "title": "PublishFacetVersionResponseV015",
  "type": "object",
  "additionalProperties": false,
  "required": ["facet", "facetVersion"],
  "properties": {
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creator",
        "facetName",
        "facetDisplayName",
        "facetType",
        "status",
        "visibility",
        "currentPublishedVersion",
        "revision"
      ],
      "properties": {
        "creator": {
          "type": "string",
          "minLength": 8,
          "maxLength": 16,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "facetName": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "facetDisplayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "facetType": { "enum": ["API", "ACTOR", "AGENT"] },
        "status": { "const": "PUBLISHED" },
        "visibility": { "enum": ["UNLISTED", "PUBLIC"] },
        "currentPublishedVersion": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "facetVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creator",
        "facetName",
        "version",
        "status",
        "visibility",
        "contentHash",
        "publishedAt",
        "revision"
      ],
      "properties": {
        "creator": {
          "type": "string",
          "minLength": 8,
          "maxLength": 16,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "facetName": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "status": { "const": "PUBLISHED" },
        "visibility": { "enum": ["UNLISTED", "PUBLIC"] },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "publishedAt": { "type": "string", "format": "date-time" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
